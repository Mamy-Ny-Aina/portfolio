{
  "name": "ndimby-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio immersif de Ndimby Razafinjatovo — site 3D multilingue, guide IA, interface d'administration et statistiques de visite.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-dist.mjs",
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"wrangler dev --port 8787 --local\"",
    "dev:web": "vite",
    "dev:api": "node scripts/ensure-dist.mjs && wrangler dev --port 8787 --local",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "setup": "node scripts/setup-cloudflare.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@preact/signals": "^2.3.1",
    "hono": "^4.13.13",
    "lenis": "^1.3.26",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@preact/preset-vite": "^2.10.6",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=20"
  }
}
