{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Fichiers statiques produits par `vite build`. Le Worker ne s'exécute en premier que
  // pour l'API, la page d'accueil (balises SEO dynamiques), le sitemap et robots.txt.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/", "/sitemap.xml", "/robots.txt"]
  },

  // Base de données (contenu, visiteurs, messages, conversations IA)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db",
      "database_id": "6e375e72-0cd7-4414-b248-ca07b8dd8240",
      "migrations_dir": "migrations"
    }
  ],

  // Stockage des fichiers téléversés (images, CV, pièces jointes)
  "kv_namespaces": [
    {
      "binding": "FILES",
      "id": "8701189ed56e4187afece2cb80534c04"
    }
  ],

  // IA gratuite de Cloudflare (10 000 neurones / jour)
  "ai": {
    "binding": "AI",
    "remote": true
  },

  "vars": {
    "CONTACT_TO_EMAIL": "ndimbyrazafinjatovo999@gmail.com",
    "AI_PROVIDER": "auto"
  },

  "observability": {
    "enabled": true
  }
}
